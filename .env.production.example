# =========================================================================
# SmartERP Enterprise Platform V2.0 — Production Server Environment (.env)
# =========================================================================

PORT=5000
NODE_ENV=production
VITE_APP_TITLE="SmartERP Enterprise"

# PostgreSQL Server Database Connection
# Replace with your actual production database credentials:
DATABASE_URL="postgresql://smarterp_admin:your_strong_password_here@localhost:5432/smarterp_db"

# JWT Security Secrets (Use random 32+ character strings for production!)
JWT_ACCESS_SECRET="CHANGE_ME_TO_A_VERY_LONG_SECURE_RANDOM_STRING_FOR_PROD_ACCESS_KEY"
JWT_REFRESH_SECRET="CHANGE_ME_TO_A_VERY_LONG_SECURE_RANDOM_STRING_FOR_PROD_REFRESH_KEY"
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="30d"

# Allowed CORS Origins (Include your server IP or domain)
CORS_ORIGIN="http://localhost:5000,http://your-server-ip:5000,https://yourdomain.com"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000
